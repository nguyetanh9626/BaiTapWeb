# ============================================================
# Cấu hình mẫu kết nối Cơ sở dữ liệu và Mail SMTP cho baitapweb
# Đổi tên file này thành db.properties và điền thông tin thực tế của bạn
# Hoặc thiết lập qua biến môi trường (Khuyến nghị cho bảo mật):
#
# Biến môi trường Database:
#   BAITAPWEB_DB_URL=jdbc:sqlserver://localhost:1433;databaseName=baitapweb;encrypt=true;trustServerCertificate=true;
#   BAITAPWEB_DB_SERVER=localhost
#   BAITAPWEB_DB_PORT=1433
#   BAITAPWEB_DB_NAME=baitapweb
#   BAITAPWEB_DB_USER=sa
#   BAITAPWEB_DB_PASSWORD=your_db_password_here
#   BAITAPWEB_UPLOAD_DIR=C:/uploads/baitapweb
#
# Biến môi trường Mail SMTP:
#   MAIL_SMTP_HOST=smtp.gmail.com
#   MAIL_SMTP_PORT=587
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS_ENABLE=true
#   MAIL_SMTP_USERNAME=your_email@gmail.com
#   MAIL_SMTP_PASSWORD=your_16_character_app_password
#
# Biến môi trường Cloudinary (Khuyến nghị cho bảo mật):
#   CLOUDINARY_CLOUD_NAME=your_cloud_name
#   CLOUDINARY_API_KEY=your_api_key
#   CLOUDINARY_API_SECRET=your_api_secret
# ============================================================

# 1. Cấu hình Microsoft SQL Server (JDBC)
db.server=localhost
db.port=1433
db.database=baitapweb
db.integratedSecurity=false
db.user=sa
db.password=your_db_password_here

# 2. Thư mục lưu trữ file upload (video & thumbnail)
# Để trống sẽ tự động dùng: ${user.home}/baitapweb-uploads
app.upload.dir=

# 3. Cấu hình gửi Email OTP qua SMTP (Gmail / Outlook / SendGrid / Mailtrap)
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls.enable=true
mail.smtp.username=your_email@gmail.com
mail.smtp.password=your_16_character_app_password

# 4. Cấu hình Cloudinary Upload ảnh đại diện Profile
# (Có thể điền tại đây hoặc dùng biến môi trường CLOUDINARY_*)
cloudinary.cloud_name=
cloudinary.api_key=
cloudinary.api_secret=
